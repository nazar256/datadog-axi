# Standard Datadog names (preferred)
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key
DD_SITE=datadoghq.com

# Legacy aliases remain supported during migration.
# DATADOG_API_KEY=your_datadog_api_key
# DATADOG_APP_KEY=your_datadog_app_key
# DATADOG_SITE=datadoghq.com

# Discovery notes:
# - Process environment variables override values loaded from env files.
# - Default files are layered from user config, repository root, then cwd.
# - --env-file <path> loads only that file (plus process variables).
# - --no-env-file disables all file discovery.
# - A generic ~/.env is never loaded implicitly.
# Keep this file local and never commit real credentials.
